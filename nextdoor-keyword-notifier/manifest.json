{
  "manifest_version": 3,
  "name": "Nextdoor Keyword Notifier",
  "description": "Notify when Nextdoor posts match configured keywords.",
  "version": "1.0.0",
  "permissions": [
    "storage",
    "notifications",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://nextdoor.co.uk/news_feed*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://nextdoor.co.uk/news_feed*",
        "http://localhost/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
